# ----------------------------------------------------------------------
# 7. Custom circuit: Bell-state like circuit with CZ and X(1/2)
# ----------------------------------------------------------------------
print("\n🔬 Running the custom circuit (X, X^0.5, CZ, X^0.5)")

# Pick two adjacent qubits from the device
device_graph = processor.get_device().metadata.nx_graph if hasattr(processor.get_device().metadata, 'nx_graph') else None
if device_graph and device_graph.edges:
    q0, q1 = next(iter(device_graph.edges))
else:
    if processor_id == "willow_pink":
        q0 = cirq.GridQubit(6, 6)
        q1 = cirq.GridQubit(6, 7)
    else:
        q0 = cirq.GridQubit(4, 4)
        q1 = cirq.GridQubit(4, 5)

custom_circuit = cirq.Circuit(
    cirq.X(q0),
    cirq.X(q1) ** 0.5,
    cirq.CZ(q0, q1),
    cirq.X(q1) ** 0.5,
    cirq.measure([q0, q1], key="measure"),
)

results_custom = sim_engine.get_sampler(processor_id).run(custom_circuit, repetitions=3000)
print("Histogram of measurement results (bits q0 q1):")
hist = results_custom.histogram(key="measure")
print(hist)
print(f"Observed counts: 00: {hist.get(0,0)}, 01: {hist.get(1,0)}, 10: {hist.get(2,0)}, 11: {hist.get(3,0)}")

# ----------------------------------------------------------------------
# 8. Optimize the circuit for Sqrt-iSWAP gateset (NEW SECTION)
# ----------------------------------------------------------------------
print("\n🔄 Optimizing the custom circuit for Sqrt-iSWAP target gateset")
context = cirq.TransformerContext(logger=cirq.TransformerLogger())
gateset = cirq.SqrtIswapTargetGateset()
sqrt_iswap_circuit = cirq.optimize_for_target_gateset(
    custom_circuit, gateset=gateset, context=context
)

# Assert equivalence (ignoring final measurements, which are terminal)
cirq.testing.assert_circuits_with_terminal_measurements_are_equivalent(
    custom_circuit, sqrt_iswap_circuit
)

print("✅ The optimized circuit is equivalent to the original circuit.")
print("\nOriginal circuit:")
print(custom_circuit)
print("\nOptimized circuit (using Sqrt-iSWAP gates):")
print(sqrt_iswap_circuit)

# Show the transformer log (which gates were replaced)
print("\nTransformer log:")
context.logger.show()

# ----------------------------------------------------------------------
# 9. EHEPS Custom Use Case: Energy Optimization with QAOA
# ----------------------------------------------------------------------
print("\n⚡ EHEPS Quantum Energy Optimization (QAOA)")

power_data = np.array([5.0, 3.0, 4.0, 2.0])
Q = np.diag(power_data * 0.5)
avg_power = np.mean(power_data)
